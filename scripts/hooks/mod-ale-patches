#!/bin/bash
# Module-specific hook for mod-ale compatibility patches
#
# Only self-guarding patches live here: each one reads the signature the core
# being built actually declares and aligns the module with it (or skips when
# they already match). Blind pattern patches (SendTrainerList, override
# keyword, MovePath) were removed 2026-08 once their targets disappeared from
# mod-ale master.
set -e

# Hook environment
MODULE_KEY="${MODULE_KEY:-}"
MODULE_DIR="${MODULE_DIR:-}"
MODULE_NAME="${MODULE_NAME:-}"

# Feature flags (set to 0 to disable specific patches)
# OnPlayerResurrect signature patch: align module with the core being built
APPLY_RESURRECT_SIGNATURE_PATCH="${APPLY_RESURRECT_SIGNATURE_PATCH:-1}"
# CanPacketSend/CanPacketReceive signature patch: align const-ness with core
APPLY_PACKET_SIGNATURE_PATCH="${APPLY_PACKET_SIGNATURE_PATCH:-1}"
# Playerbot InterruptSpell patch: align the Lua binding with the mod-playerbots API
APPLY_PLAYERBOT_INTERRUPT_PATCH="${APPLY_PLAYERBOT_INTERRUPT_PATCH:-1}"
# Playerbot IsBot patch: align the Lua binding with the mod-playerbots API (sPlayerbotsMgr.GetPlayerbotAI)
APPLY_PLAYERBOT_ISBOT_PATCH="${APPLY_PLAYERBOT_ISBOT_PATCH:-1}"

if [ -z "$MODULE_DIR" ] || [ ! -d "$MODULE_DIR" ]; then
    echo "❌ mod-ale-patches: Invalid module directory: $MODULE_DIR"
    exit 2
fi

echo "🔧 mod-ale-patches: Checking compatibility fixes for $MODULE_NAME"

# Locate a core header by path relative to the source root.
# MODULES_REBUILD_SOURCE_PATH may be relative to the project root, which is
# not our cwd, so also try layout-derived locations: when the hook runs on a
# module staged inside the source tree (<source>/modules/<mod>), the module's
# grandparent IS the core; when it runs on a storage checkout
# (<storage>/modules/<mod>), the core lives under <storage>/source/.
# Prints the header path, or nothing if not found.
find_core_header() {
    local header_rel="$1"
    local grandparent
    grandparent="$(cd "$MODULE_DIR/../.." 2>/dev/null && pwd)"
    local candidate
    for candidate in \
        "${MODULES_REBUILD_SOURCE_PATH:-}" \
        "$grandparent" \
        "$grandparent/source/azerothcore-playerbots" \
        "$grandparent/source/azerothcore"; do
        if [ -n "$candidate" ] && [ -f "$candidate/$header_rel" ]; then
            echo "$candidate/$header_rel"
            return 0
        fi
    done
    return 1
}

# Apply OnPlayerResurrect signature compatibility patch
# Upstream AzerothCore changed PlayerScript::OnPlayerResurrect's 3rd
# parameter from `bool` to `bool&`, and mod-ale master followed. Cores that
# lag upstream (e.g. the playerbots fork) still declare it by value, so a
# fresh mod-ale checkout fails to compile against them. Align the module's
# override with whatever signature the core being built actually declares.
apply_resurrect_signature_patch() {
    local target_file="$MODULE_DIR/src/ALE_SC.cpp"

    if [ ! -f "$target_file" ]; then
        echo "   ⚠️  Resurrect signature patch target file missing: $target_file"
        return 1
    fi
    if ! grep -q 'OnPlayerResurrect' "$target_file"; then
        echo "   ✅ Module has no OnPlayerResurrect override; nothing to do"
        return 0
    fi

    local core_header
    core_header="$(find_core_header "src/server/game/Scripting/ScriptDefines/PlayerScript.h")" || core_header=""

    local core_wants_ref=""
    if [ -n "$core_header" ]; then
        local core_sig
        core_sig="$(grep 'OnPlayerResurrect' "$core_header" | head -1)"
        if echo "$core_sig" | grep -q 'bool&'; then
            core_wants_ref=1
        else
            core_wants_ref=0
        fi
    else
        # Never guess: patching against an assumed core silently breaks the
        # build when the fork catches up to upstream signatures.
        echo "   ℹ️  Core header not found; skipping resurrect signature check"
        return 0
    fi

    local module_has_ref=0
    if grep 'OnPlayerResurrect' "$target_file" | grep -q 'bool&'; then
        module_has_ref=1
    fi

    if [ "$core_wants_ref" = "$module_has_ref" ]; then
        echo "   ✅ OnPlayerResurrect signature already matches core"
        return 0
    fi

    if [ "$core_wants_ref" = "0" ]; then
        if sed -i '/OnPlayerResurrect/s/bool&/bool/' "$target_file"; then
            echo "   ✅ Patched OnPlayerResurrect to by-value bool (older core)"
            return 0
        fi
    else
        if sed -i '/OnPlayerResurrect/s/, bool /, bool\& /' "$target_file"; then
            echo "   ✅ Patched OnPlayerResurrect to bool& (newer core)"
            return 0
        fi
    fi
    echo "   ❌ Failed to apply OnPlayerResurrect signature patch"
    return 2
}

# Apply CanPacketSend/CanPacketReceive signature compatibility patch
# Upstream mod-ale (azerothcore/mod-ale#366) changed the packet hooks to
# take `WorldPacket const&` to match newer AzerothCore; older cores still
# declare `WorldPacket&`. Align the module's overrides with the core.
apply_packet_signature_patch() {
    local target_file="$MODULE_DIR/src/ALE_SC.cpp"

    if [ ! -f "$target_file" ]; then
        echo "   ⚠️  Packet signature patch target file missing: $target_file"
        return 1
    fi
    if ! grep -qE 'CanPacket(Send|Receive)' "$target_file"; then
        echo "   ✅ Module has no CanPacketSend/CanPacketReceive overrides; nothing to do"
        return 0
    fi

    local core_header
    core_header="$(find_core_header "src/server/game/Scripting/ScriptDefines/ServerScript.h")" || core_header=""

    local core_wants_const=""
    if [ -n "$core_header" ]; then
        local core_sig
        core_sig="$(grep 'CanPacketSend' "$core_header" | head -1)"
        if echo "$core_sig" | grep -qE 'WorldPacket const&|const WorldPacket&'; then
            core_wants_const=1
        else
            core_wants_const=0
        fi
    else
        # Never guess: patching against an assumed core silently breaks the
        # build when the fork catches up to upstream signatures.
        echo "   ℹ️  Core header not found; skipping packet signature check"
        return 0
    fi

    local module_has_const=0
    if grep -E 'CanPacket(Send|Receive)' "$target_file" | grep -qE 'WorldPacket const&|const WorldPacket&'; then
        module_has_const=1
    fi

    if [ "$core_wants_const" = "$module_has_const" ]; then
        echo "   ✅ Packet hook signatures already match core"
        return 0
    fi

    if [ "$core_wants_const" = "0" ]; then
        if sed -i -E '/CanPacket(Send|Receive)/{s/WorldPacket const&/WorldPacket\&/;s/const WorldPacket&/WorldPacket\&/;}' "$target_file"; then
            echo "   ✅ Patched packet hooks to non-const WorldPacket& (older core)"
            return 0
        fi
    else
        if sed -i -E '/CanPacket(Send|Receive)/s/WorldPacket&/WorldPacket const\&/' "$target_file"; then
            echo "   ✅ Patched packet hooks to WorldPacket const& (newer core)"
            return 0
        fi
    fi
    echo "   ❌ Failed to apply packet signature patch"
    return 2
}

# Locate headers from the mod-playerbots checkout that mod-ale will be compiled against.
# Modules are staged as siblings under <source>/modules/, and mod-playerbots
# precedes mod-ale in the manifest, so it is normally already cloned when this
# hook runs. Prints the header path, or nothing if not found.
find_playerbot_header() {
    local header_name="$1"
    local grandparent
    grandparent="$(cd "$MODULE_DIR/../.." 2>/dev/null && pwd)"
    local base candidate
    for base in \
        "$MODULE_DIR/../mod-playerbots" \
        "$grandparent/modules/mod-playerbots" \
        "${MODULES_REBUILD_SOURCE_PATH:+$MODULES_REBUILD_SOURCE_PATH/modules/mod-playerbots}"; do
        [ -n "$base" ] || continue
        for candidate in "$base/src/Bot/$header_name" "$base/src/$header_name"; do
            if [ -f "$candidate" ]; then
                echo "$candidate"
                return 0
            fi
        done
    done
    return 1
}

find_playerbot_ai_header() {
    find_playerbot_header "PlayerbotAI.h"
}

find_playerbot_mgr_header() {
    find_playerbot_header "PlayerbotMgr.h"
}

# Apply Playerbot InterruptSpell compatibility patch
# mod-playerbots #2680 ("Rework Spell Interrupt Calls in Actions") removed
# PlayerbotAI::InterruptSpell() in favour of the deferred
# PlayerbotAI::RequestSpellInterrupt(), which the bot honours on its next AI
# update. mod-ale #397 added Lua bindings written against the old API, so a
# fresh checkout of both fails to compile (azerothcore/mod-ale#398). Delegate
# the binding to the new call when, and only when, the playerbots checkout
# being built no longer declares the old one.
apply_playerbot_interrupt_patch() {
    local target_file="$MODULE_DIR/src/LuaEngine/methods/Playerbots/PlayerBotAIMethods.h"

    if [ ! -f "$target_file" ]; then
        echo "   ✅ Module has no Playerbot AI bindings; nothing to do"
        return 0
    fi
    if ! grep -q 'botAI->InterruptSpell()' "$target_file"; then
        echo "   ✅ Playerbot InterruptSpell binding already matches mod-playerbots"
        return 0
    fi

    local pb_header
    pb_header="$(find_playerbot_ai_header)" || pb_header=""
    if [ -z "$pb_header" ]; then
        # Never guess: patching against an assumed playerbots API silently
        # breaks the build when the checkout still has the old call.
        echo "   ℹ️  mod-playerbots checkout not found; skipping InterruptSpell check"
        return 0
    fi

    if grep -qE '\bvoid\s+InterruptSpell\s*\(\s*\)' "$pb_header"; then
        echo "   ✅ mod-playerbots still declares PlayerbotAI::InterruptSpell(); nothing to do"
        return 0
    fi
    if ! grep -qE '\bRequestSpellInterrupt\s*\(' "$pb_header"; then
        echo "   ❌ mod-playerbots declares neither InterruptSpell() nor RequestSpellInterrupt(); cannot patch"
        return 2
    fi

    if sed -i 's/botAI->InterruptSpell()/botAI->RequestSpellInterrupt()/' "$target_file"; then
        echo "   ✅ Patched Playerbot InterruptSpell binding to RequestSpellInterrupt() (mod-playerbots #2680)"
        return 0
    fi
    echo "   ❌ Failed to apply Playerbot InterruptSpell patch"
    return 2
}

# Apply Playerbot IsBot compatibility patch
# mod-playerbots #2864 / commit 037c0141 refactored bot status detection:
# WorldSession::IsBot() was removed in favour of the centralized PlayerbotsMgr
# (sPlayerbotsMgr.GetPlayerbotAI(player) != nullptr). mod-ale's PlayerMethods.h
# still calls player->GetSession()->IsBot(), failing compilation when built
# against the updated playerbots branch. Patch PlayerMethods.h to include
# PlayerbotAI.h / PlayerbotMgr.h and query sPlayerbotsMgr.GetPlayerbotAI(player)
# when WorldSession::IsBot() is no longer declared by the core.
apply_playerbot_isbot_patch() {
    local target_file="$MODULE_DIR/src/LuaEngine/methods/PlayerMethods.h"

    if [ ! -f "$target_file" ]; then
        echo "   ⚠️  Playerbot IsBot patch target file missing: $target_file"
        return 1
    fi
    if grep -q 'sPlayerbotsMgr.GetPlayerbotAI' "$target_file"; then
        echo "   ✅ Playerbot IsBot binding already matches mod-playerbots"
        return 0
    fi
    if ! grep -q 'player->GetSession()->IsBot()' "$target_file"; then
        echo "   ✅ Module has no player->GetSession()->IsBot() call; nothing to do"
        return 0
    fi

    local core_header
    core_header="$(find_core_header "src/server/game/Server/WorldSession.h")" || core_header=""

    if [ -n "$core_header" ]; then
        if grep -qE '\bIsBot\s*\(' "$core_header"; then
            echo "   ✅ Core WorldSession still declares IsBot(); nothing to do"
            return 0
        fi
    else
        local pb_mgr_header
        pb_mgr_header="$(find_playerbot_mgr_header)" || pb_mgr_header=""
        if [ -z "$pb_mgr_header" ]; then
            # Never guess: skipping when neither core nor playerbots header is found
            echo "   ℹ️  Core header and mod-playerbots checkout not found; skipping IsBot check"
            return 0
        fi
    fi

    local pb_mgr
    pb_mgr="$(find_playerbot_mgr_header)" || pb_mgr=""
    if [ -n "$pb_mgr" ] && ! grep -qE '\bGetPlayerbotAI\s*\(' "$pb_mgr"; then
        echo "   ❌ mod-playerbots PlayerbotMgr.h does not declare GetPlayerbotAI(); cannot patch"
        return 2
    fi

    # Anchor 1: Include headers under #ifdef MOD_PLAYERBOTS
    if ! grep -q 'PlayerbotMgr\.h' "$target_file"; then
        if ! grep -q '#include "GossipDef\.h"' "$target_file"; then
            echo "   ❌ Anchor '#include \"GossipDef.h\"' not found in $target_file; cannot insert headers"
            return 2
        fi
        if ! sed -i '/#include "GossipDef\.h"/a \
\
#ifdef MOD_PLAYERBOTS\
#include "PlayerbotAI.h"\
#include "PlayerbotMgr.h"\
#endif' "$target_file"; then
            echo "   ❌ Failed to insert Playerbot includes in $target_file"
            return 2
        fi
    fi

    # Anchor 2: Replace player->GetSession()->IsBot()
    if ! sed -i 's/player->GetSession()->IsBot()/player \&\& sPlayerbotsMgr.GetPlayerbotAI(player) != nullptr/' "$target_file"; then
        echo "   ❌ Failed to replace player->GetSession()->IsBot() in $target_file"
        return 2
    fi

    if grep -q 'sPlayerbotsMgr.GetPlayerbotAI' "$target_file"; then
        echo "   ✅ Patched Playerbot IsBot binding to sPlayerbotsMgr.GetPlayerbotAI (mod-playerbots #2864/037c014)"
        return 0
    fi

    echo "   ❌ Failed to apply Playerbot IsBot patch"
    return 2
}

# Apply all patches. Each returns 0 (patched or nothing to do), 1 (warning,
# e.g. target file missing) or 2 (patch failed); the hook exits with the worst.
checked=0
warned=0
failed=0
run_patch() {
    local rc=0
    "$@" || rc=$?
    checked=$((checked + 1))
    case $rc in
        0) ;;
        1) warned=$((warned + 1)) ;;
        *) failed=$((failed + 1)) ;;
    esac
}
if [ "$APPLY_RESURRECT_SIGNATURE_PATCH" = "1" ]; then
    run_patch apply_resurrect_signature_patch
fi
if [ "$APPLY_PACKET_SIGNATURE_PATCH" = "1" ]; then
    run_patch apply_packet_signature_patch
fi
if [ "$APPLY_PLAYERBOT_INTERRUPT_PATCH" = "1" ]; then
    run_patch apply_playerbot_interrupt_patch
fi
if [ "$APPLY_PLAYERBOT_ISBOT_PATCH" = "1" ]; then
    run_patch apply_playerbot_isbot_patch
fi

if [ "$failed" -gt 0 ]; then
    echo "   ❌ $failed of $checked compatibility patch(es) failed; mod-ale may not compile"
    exit 2
fi
if [ "$warned" -gt 0 ]; then
    echo "   ⚠️  $warned of $checked compatibility check(s) could not run; see warnings above"
    exit 1
fi
echo "   ✅ $checked compatibility check(s) passed"
exit 0
