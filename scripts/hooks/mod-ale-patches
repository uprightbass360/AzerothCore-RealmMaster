#!/bin/bash
# Module-specific hook for mod-ale compatibility patches
# NOTE: These patches are primarily needed for the AzerothCore playerbots fork
set -e

# Hook environment
MODULE_KEY="${MODULE_KEY:-}"
MODULE_DIR="${MODULE_DIR:-}"
MODULE_NAME="${MODULE_NAME:-}"

# Detect if we're building with playerbots fork
IS_PLAYERBOTS_FORK=0

# Method 1: Check STACK_SOURCE_VARIANT environment variable
if [ "${STACK_SOURCE_VARIANT:-}" = "playerbots" ]; then
    IS_PLAYERBOTS_FORK=1
    echo "   ✅ Playerbots detected via STACK_SOURCE_VARIANT"
# Method 2: Check MODULES_REBUILD_SOURCE_PATH
elif [ -n "${MODULES_REBUILD_SOURCE_PATH:-}" ] && echo "${MODULES_REBUILD_SOURCE_PATH}" | grep -q "azerothcore-playerbots"; then
    IS_PLAYERBOTS_FORK=1
    echo "   ✅ Playerbots detected via MODULES_REBUILD_SOURCE_PATH"
else
    echo "   ❌ Playerbots fork not detected"
    echo "   🔍 Debug: STACK_SOURCE_VARIANT='${STACK_SOURCE_VARIANT:-}'"
    echo "   🔍 Debug: MODULES_REBUILD_SOURCE_PATH='${MODULES_REBUILD_SOURCE_PATH:-}'"
fi

# Feature flags (set to 0 to disable specific patches)
APPLY_MOVEPATH_PATCH="${APPLY_MOVEPATH_PATCH:-0}"  # Disabled by default - appears unnecessary
# SendTrainerList patch: auto-detect based on fork, but can be overridden
if [ -z "${APPLY_SENDTRAINERLIST_PATCH:-}" ]; then
    APPLY_SENDTRAINERLIST_PATCH="$IS_PLAYERBOTS_FORK"  # Only needed for playerbots fork
else
    APPLY_SENDTRAINERLIST_PATCH="${APPLY_SENDTRAINERLIST_PATCH}"
fi
# Override keyword patch: always apply (C++11 best practice)
APPLY_OVERRIDE_PATCH="${APPLY_OVERRIDE_PATCH:-1}"
# OnPlayerResurrect signature patch: align module with the core being built
APPLY_RESURRECT_SIGNATURE_PATCH="${APPLY_RESURRECT_SIGNATURE_PATCH:-1}"
# CanPacketSend/CanPacketReceive signature patch: align const-ness with core
APPLY_PACKET_SIGNATURE_PATCH="${APPLY_PACKET_SIGNATURE_PATCH:-1}"

if [ -z "$MODULE_DIR" ] || [ ! -d "$MODULE_DIR" ]; then
    echo "❌ mod-ale-patches: Invalid module directory: $MODULE_DIR"
    exit 2
fi

if [ "$IS_PLAYERBOTS_FORK" = "1" ]; then
    echo "🔧 mod-ale-patches: Applying playerbots fork compatibility fixes to $MODULE_NAME"
else
    echo "🔧 mod-ale-patches: Checking compatibility fixes for $MODULE_NAME"
fi

# Apply MovePath compatibility patch
apply_movepath_patch() {
    local target_file="$MODULE_DIR/src/LuaEngine/methods/CreatureMethods.h"

    if [ ! -f "$target_file" ]; then
        echo "   ⚠️  MovePath patch target file missing: $target_file"
        return 1
    fi

    if grep -q 'MoveWaypoint(creature->GetWaypointPath(), true);' "$target_file"; then
        if sed -i 's/MoveWaypoint(creature->GetWaypointPath(), true);/MovePath(creature->GetWaypointPath(), FORCED_MOVEMENT_RUN);/' "$target_file"; then
            echo "   ✅ Applied MovePath compatibility fix"
            return 0
        else
            echo "   ❌ Failed to apply MovePath compatibility fix"
            return 2
        fi
    else
        echo "   ✅ MovePath compatibility fix already present"
        return 0
    fi
}

# Apply override keyword patch
apply_override_patch() {
    local found_files=()

    # Search for .cpp and .h files that need override keyword
    while IFS= read -r -d '' file; do
        if grep -l 'void OnPlayerLogin(Player\* player)' "$file" >/dev/null 2>&1; then
            found_files+=("$file")
        fi
    done < <(find "$MODULE_DIR" -name "*.cpp" -o -name "*.h" -print0)

    if [ ${#found_files[@]} -eq 0 ]; then
        echo "   ✅ No files need override keyword fix"
        return 0
    fi

    local patch_count=0
    for file in "${found_files[@]}"; do
        # Check if OnPlayerLogin exists without override keyword
        if grep -q 'void OnPlayerLogin(Player\* player) {' "$file" && ! grep -q 'void OnPlayerLogin(Player\* player) override {' "$file"; then
            if sed -i 's/void OnPlayerLogin(Player\* player) {/void OnPlayerLogin(Player* player) override {/' "$file"; then
                echo "   ✅ Applied override keyword fix to $(basename "$file")"
                patch_count=$((patch_count + 1))
            else
                echo "   ❌ Failed to apply override keyword fix to $(basename "$file")"
                return 2
            fi
        fi
    done

    if [ $patch_count -eq 0 ]; then
        echo "   ✅ Override keyword fix already present"
    else
        echo "   ✅ Applied override keyword fix to $patch_count file(s)"
    fi
    return 0
}

# Locate a core header by path relative to the source root.
# MODULES_REBUILD_SOURCE_PATH may be relative to the project root, which is
# not our cwd, so also try layout-derived locations: when the hook runs on a
# module staged inside the source tree (<source>/modules/<mod>), the module's
# grandparent IS the core; when it runs on a storage checkout
# (<storage>/modules/<mod>), the core lives under <storage>/source/.
# Prints the header path, or nothing if not found.
find_core_header() {
    local header_rel="$1"
    local grandparent
    grandparent="$(cd "$MODULE_DIR/../.." 2>/dev/null && pwd)"
    local candidate
    for candidate in \
        "${MODULES_REBUILD_SOURCE_PATH:-}" \
        "$grandparent" \
        "$grandparent/source/azerothcore-playerbots" \
        "$grandparent/source/azerothcore"; do
        if [ -n "$candidate" ] && [ -f "$candidate/$header_rel" ]; then
            echo "$candidate/$header_rel"
            return 0
        fi
    done
    return 1
}

# Apply OnPlayerResurrect signature compatibility patch
# Upstream AzerothCore changed PlayerScript::OnPlayerResurrect's 3rd
# parameter from `bool` to `bool&`, and mod-ale master followed. Cores that
# lag upstream (e.g. the playerbots fork) still declare it by value, so a
# fresh mod-ale checkout fails to compile against them. Align the module's
# override with whatever signature the core being built actually declares.
apply_resurrect_signature_patch() {
    local target_file="$MODULE_DIR/src/ALE_SC.cpp"

    if [ ! -f "$target_file" ]; then
        echo "   ⚠️  Resurrect signature patch target file missing: $target_file"
        return 1
    fi
    if ! grep -q 'OnPlayerResurrect' "$target_file"; then
        echo "   ✅ Module has no OnPlayerResurrect override; nothing to do"
        return 0
    fi

    local core_header
    core_header="$(find_core_header "src/server/game/Scripting/ScriptDefines/PlayerScript.h")" || core_header=""

    local core_wants_ref=""
    if [ -n "$core_header" ]; then
        local core_sig
        core_sig="$(grep 'OnPlayerResurrect' "$core_header" | head -1)"
        if echo "$core_sig" | grep -q 'bool&'; then
            core_wants_ref=1
        else
            core_wants_ref=0
        fi
    else
        # Never guess: patching against an assumed core silently breaks the
        # build when the fork catches up to upstream signatures.
        echo "   ℹ️  Core header not found; skipping resurrect signature check"
        return 0
    fi

    local module_has_ref=0
    if grep 'OnPlayerResurrect' "$target_file" | grep -q 'bool&'; then
        module_has_ref=1
    fi

    if [ "$core_wants_ref" = "$module_has_ref" ]; then
        echo "   ✅ OnPlayerResurrect signature already matches core"
        return 0
    fi

    if [ "$core_wants_ref" = "0" ]; then
        if sed -i '/OnPlayerResurrect/s/bool&/bool/' "$target_file"; then
            echo "   ✅ Patched OnPlayerResurrect to by-value bool (older core)"
            return 0
        fi
    else
        if sed -i '/OnPlayerResurrect/s/, bool /, bool\& /' "$target_file"; then
            echo "   ✅ Patched OnPlayerResurrect to bool& (newer core)"
            return 0
        fi
    fi
    echo "   ❌ Failed to apply OnPlayerResurrect signature patch"
    return 2
}

# Apply CanPacketSend/CanPacketReceive signature compatibility patch
# Upstream mod-ale (azerothcore/mod-ale#366) changed the packet hooks to
# take `WorldPacket const&` to match newer AzerothCore; older cores still
# declare `WorldPacket&`. Align the module's overrides with the core.
apply_packet_signature_patch() {
    local target_file="$MODULE_DIR/src/ALE_SC.cpp"

    if [ ! -f "$target_file" ]; then
        echo "   ⚠️  Packet signature patch target file missing: $target_file"
        return 1
    fi
    if ! grep -qE 'CanPacket(Send|Receive)' "$target_file"; then
        echo "   ✅ Module has no CanPacketSend/CanPacketReceive overrides; nothing to do"
        return 0
    fi

    local core_header
    core_header="$(find_core_header "src/server/game/Scripting/ScriptDefines/ServerScript.h")" || core_header=""

    local core_wants_const=""
    if [ -n "$core_header" ]; then
        local core_sig
        core_sig="$(grep 'CanPacketSend' "$core_header" | head -1)"
        if echo "$core_sig" | grep -qE 'WorldPacket const&|const WorldPacket&'; then
            core_wants_const=1
        else
            core_wants_const=0
        fi
    else
        # Never guess: patching against an assumed core silently breaks the
        # build when the fork catches up to upstream signatures.
        echo "   ℹ️  Core header not found; skipping packet signature check"
        return 0
    fi

    local module_has_const=0
    if grep -E 'CanPacket(Send|Receive)' "$target_file" | grep -qE 'WorldPacket const&|const WorldPacket&'; then
        module_has_const=1
    fi

    if [ "$core_wants_const" = "$module_has_const" ]; then
        echo "   ✅ Packet hook signatures already match core"
        return 0
    fi

    if [ "$core_wants_const" = "0" ]; then
        if sed -i -E '/CanPacket(Send|Receive)/{s/WorldPacket const&/WorldPacket\&/;s/const WorldPacket&/WorldPacket\&/;}' "$target_file"; then
            echo "   ✅ Patched packet hooks to non-const WorldPacket& (older core)"
            return 0
        fi
    else
        if sed -i -E '/CanPacket(Send|Receive)/s/WorldPacket&/WorldPacket const\&/' "$target_file"; then
            echo "   ✅ Patched packet hooks to WorldPacket const& (newer core)"
            return 0
        fi
    fi
    echo "   ❌ Failed to apply packet signature patch"
    return 2
}

# Apply SendTrainerList compatibility patch
apply_sendtrainerlist_patch() {
    local target_file="$MODULE_DIR/src/LuaEngine/methods/PlayerMethods.h"

    if [ ! -f "$target_file" ]; then
        echo "   ⚠️  SendTrainerList patch target file missing: $target_file"
        return 1
    fi

    # Check if the buggy code exists (with ->GetGUID())
    if grep -q 'player->GetSession()->SendTrainerList(obj->GetGUID());' "$target_file"; then
        # Apply the fix by casting to Creature* instead of using GetGUID()
        if sed -i 's/player->GetSession()->SendTrainerList(obj->GetGUID());/if (Creature* creature = obj->ToCreature()) player->GetSession()->SendTrainerList(creature);/' "$target_file"; then
            echo "   ✅ Applied SendTrainerList compatibility fix"
            return 0
        else
            echo "   ❌ Failed to apply SendTrainerList compatibility fix"
            return 2
        fi
    else
        echo "   ✅ SendTrainerList compatibility fix already present"
        return 0
    fi
}

# Apply all patches
patch_count=0
if [ "$APPLY_OVERRIDE_PATCH" = "1" ]; then
    if apply_override_patch; then
        patch_count=$((patch_count + 1))
    fi
fi
if [ "$APPLY_MOVEPATH_PATCH" = "1" ]; then
    if apply_movepath_patch; then
        patch_count=$((patch_count + 1))
    fi
fi
if [ "$APPLY_SENDTRAINERLIST_PATCH" = "1" ]; then
    if apply_sendtrainerlist_patch; then
        patch_count=$((patch_count + 1))
    fi
fi
if [ "$APPLY_RESURRECT_SIGNATURE_PATCH" = "1" ]; then
    if apply_resurrect_signature_patch; then
        patch_count=$((patch_count + 1))
    fi
fi
if [ "$APPLY_PACKET_SIGNATURE_PATCH" = "1" ]; then
    if apply_packet_signature_patch; then
        patch_count=$((patch_count + 1))
    fi
fi

if [ $patch_count -eq 0 ]; then
    echo "   ℹ️  No patches needed or applied"
    exit 0
fi

echo "   ✅ Applied $patch_count compatibility patch(es)"
exit 0