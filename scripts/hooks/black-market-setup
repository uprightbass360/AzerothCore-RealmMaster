#!/bin/bash
# Module-specific hook for Black Market Auction House setup
set -e

# shellcheck source-path=SCRIPTDIR source=lib/lua-staging.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/lua-staging.sh"

lua_stage_init black-market-setup

lua_stage_tree "$MODULE_DIR/Server Files/lua_scripts" "Black Market server scripts"

# Identify client files (for information)
client_dir="$MODULE_DIR/Client Files"
if [ -d "$client_dir" ]; then
    echo "   ℹ️  Client files detected at '$client_dir' (manual installation required)"
    if [ -d "$client_dir/AddOns" ]; then
        echo "      📁 AddOns directory found - install to WoW client"
    fi
fi

lua_stage_finish
