#!/bin/bash
# Generic hook to stage standard Lua scripts for ALE
set -e

# shellcheck source-path=SCRIPTDIR source=lib/lua-staging.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/lua-staging.sh"

lua_stage_init copy-standard-lua

# Search locations (in priority order)
lua_stage_files "$MODULE_DIR/lua_scripts" "lua_scripts/ directory"
lua_stage_files "$MODULE_DIR/Server Files/lua_scripts" "Server Files/lua_scripts/ (Black Market pattern)"
lua_stage_files "$MODULE_DIR/scripts" "scripts/ directory"
lua_stage_files "$MODULE_DIR" "root level Lua files"

lua_stage_finish
