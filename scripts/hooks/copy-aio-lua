#!/bin/bash
# Generic hook to stage AIO (Azeroth Interface Override) server Lua scripts
set -e

# shellcheck source-path=SCRIPTDIR source=lib/lua-staging.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/lua-staging.sh"

lua_stage_init copy-aio-lua

# AIO-specific search locations
lua_stage_files "$MODULE_DIR/Server" "Server/ directory (AIO pattern)"
lua_stage_files "$MODULE_DIR/server" "server/ directory (lowercase)"
lua_stage_files "$MODULE_DIR/lua_scripts" "lua_scripts/ directory"
lua_stage_files "$MODULE_DIR/Server Files/lua_scripts" "Server Files/lua_scripts/ directory"
lua_stage_files "$MODULE_DIR" "root level Lua files"

# AIO modules may have client files too (for reference)
if [ -d "$MODULE_DIR/Client" ] || [ -d "$MODULE_DIR/client" ]; then
    echo "   ℹ️  Note: Client-side AIO files detected (not copied to server)"
fi

lua_stage_finish
